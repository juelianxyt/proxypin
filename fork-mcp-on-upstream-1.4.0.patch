diff --git a/lib/ui/toolbox/mcp_server_page.dart b/lib/ui/toolbox/mcp_server_page.dart
new file mode 100644
index 0000000..ab5746e
--- /dev/null
+++ b/lib/ui/toolbox/mcp_server_page.dart
@@ -0,0 +1,518 @@
+/*
